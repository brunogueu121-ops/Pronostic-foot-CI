NODE_ENV=development
PORT=3000
# Au moins 32 caractères aléatoires. Générer une valeur unique pour chaque déploiement.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Token obtenu dans le compte fournisseur; ne jamais le placer dans index.html.
FOOTBALL_DATA_TOKEN=
# Origine HTTPS exacte de l'application web déployée, sans slash final.
APP_ORIGIN=http://localhost:8080
# Identifiant admin initial. Le mot de passe doit être stocké en bcrypt hash.
ADMIN_EMAIL=admin@example.ci
ADMIN_PASSWORD_HASH=
